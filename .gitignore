# The `vnx` command-line tool, built into whichever directory `go build` ran in.
/vnx
go/vnx
go/cmd/vnx/vnx

.DS_Store

# SwiftPM builds into the directory holding the manifest, which is the
# repository root. The `swift/` entries catch a build left by a checkout from
# before the manifest moved.
.build/
.swiftpm/
*.xcodeproj
