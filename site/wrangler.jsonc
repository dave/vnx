// vnx.tools: a static site served from Cloudflare Workers static assets.
// Deploy with `npm run deploy` (needs Dave's go: it publishes the site).
{
  "name": "vnx-tools",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "vnx.tools", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
